# Public application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public values are safe in the browser; protect the service role)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only

# HERE (use separate apps/credentials; restrict the browser key to your domains)
NEXT_PUBLIC_HERE_MAPS_API_KEY=replace_me_domain_restricted
HERE_SERVER_API_KEY=replace_me_server_only

# Official data services
NWS_USER_AGENT=MoveAtlas/1.0 (support@move-atlas.example)
CENSUS_API_KEY=replace_me_server_only
CRON_SECRET=replace_me_with_at_least_24_random_characters
# Reserved for a future BLS adapter; setting this does not enable BLS today
BLS_API_KEY=

# Reserved optional credentials; setting these does not enable an adapter today
OPENAI_API_KEY=
SENTRY_DSN=
